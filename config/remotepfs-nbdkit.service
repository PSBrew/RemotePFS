[Unit]
Description=RemotePFS nbdkit read-only NBD server
After=network-online.target
Before=remotepfs.service

[Service]
Type=simple
User=remotepfs-nbd
Group=remotepfs
RuntimeDirectory=remotepfs
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/nbdkit -U /run/remotepfs/nbd.sock --pidfile /run/remotepfs/nbdkit.pid --unix-mode=0600 --exit-with-parent --threads 1 --max-request 98304 --readonly --filter=blocksize --filter=cache python /opt/remotepfs/source/src/remotepfs/remotepfs_nbd.py mapper_state=/var/lib/remotepfs/mapper.state minblock=512 maxdata=65536 maxlen=134217728 cache-min-block-size=262144 cache-max-size=1073741824 cache-on-read=true
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/opt/remotepfs/source /var/lib/remotepfs
ReadWritePaths=/run/remotepfs
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
